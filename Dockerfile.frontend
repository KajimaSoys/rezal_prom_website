# Stage 1: Vue build (reads client/.env for VITE_* at build time)
FROM node:22-alpine AS build-stage
WORKDIR /app
COPY client/package*.json ./
RUN npm ci --no-audit --no-fund
COPY client/ .
RUN npm run build

# Stage 2: the same unprivileged nginx image that the monitoring stack already uses
# on the server (no extra base image download). Runs as uid 101, listens on 8080.
FROM nginxinc/nginx-unprivileged:1.31.7-alpine
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build-stage /app/dist /usr/share/nginx/html
